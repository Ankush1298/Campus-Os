<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts (navy + CampusOS symbol). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/campusos_midnight</item>
        <item name="android:navigationBarColor">@color/campusos_midnight</item>
    </style>
    <!-- Behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

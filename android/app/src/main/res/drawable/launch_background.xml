<?xml version="1.0" encoding="utf-8"?>
<!-- CampusOS native splash: midnight navy with the centred symbol. Removed when Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/campusos_midnight" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_splash_logo" />
    </item>
</layer-list>
